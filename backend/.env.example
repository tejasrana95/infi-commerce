# Server Configuration
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
SENTRY_DSN=

# For Demo Mode
DEMO=true
# Database
MONGODB_URI=mongodb://localhost:27017/infi_commerce

# ---------------------------------------------------------------------------
# Activity & API logging (dedicated PostgreSQL server, `logs` schema)
# ---------------------------------------------------------------------------
# When LOG_DATABASE_URL is empty, all log capture and log read endpoints are
# disabled and the application runs normally.
LOG_DATABASE_URL=postgresql://user:password@localhost:5432/infi_logs
LOG_DB_POOL_MAX=10
LOG_DB_STATEMENT_TIMEOUT_MS=30000

# Maintenance scheduler (runs inside the API process)
LOG_MAINTENANCE_ENABLED=true
LOG_ROLLUP_INTERVAL_MS=300000
LOG_ROLLUP_LOOKBACK_HOURS=3
LOG_PARTITION_AHEAD_MONTHS=3

# Partition retention. NOTE: dropping partitions is irreversible, so this is
# opt-in and defaults to off. Confirm your compliance window before enabling.
# Logs never auto-expire while this is false; set it deliberately.
LOG_RETENTION_ENABLED=false
LOG_RETENTION_API_DAYS=90
LOG_RETENTION_ACTIVITY_DAYS=365
LOG_RETENTION_AUDIT_DAYS=365
LOG_RETENTION_SECURITY_DAYS=365
LOG_RETENTION_SEARCH_DAYS=180
LOG_RETENTION_SYSTEM_DAYS=90

# ---------------------------------------------------------------------------
# LEGACY: only needed to run `npm run logs:backfill` to copy historical log
# documents out of MongoDB. Not read by the running application.
# ---------------------------------------------------------------------------
LOG_MONGODB_URI=mongodb://localhost:27017/infi_commerce_logs

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
STATIC_URL=http://localhost:3001
POS_URL=http://localhost:3004
# S3 / S3-Compatible Storage Configuration (for file uploads)
# STORAGE_PROVIDER options: local | s3 | r2 | cloudflare | s3-compatible
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
# Custom S3-compatible endpoint (e.g. Cloudflare R2, MinIO, Wasabi)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Custom CDN or public domain URL
S3_PUBLIC_URL=https://cdn.example.com
# Optional: Set to true if provider requires path-style access (e.g., MinIO)
S3_FORCE_PATH_STYLE=false

# Payment Gateways
# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# SMTP Configuration (for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
REVALIDATION_SECRET="INFICommerce-505"

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=infi:

# Memcached Configuration (optional, L1 cache — fastest)
# Set MEMCACHED_ENABLED=true if Memcached is running
MEMCACHED_ENABLED=false
# Comma-separated list of server:port (supports clusters)
MEMCACHED_SERVERS=127.0.0.1:11211
MEMCACHED_KEY_PREFIX=infi:
# Default item lifetime in seconds
MEMCACHED_LIFETIME=300

# Category API Cache (GET /api/categories)
# Use long TTL because categories change infrequently.
# Examples: 7 or 30
CATEGORY_API_CACHE_ENABLED=true
CATEGORY_API_CACHE_TTL_DAYS=7
