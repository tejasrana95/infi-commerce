<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>Invoice #{{order.orderNumber}}</title>
    <style>
        body {
            font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
            color: #555;
            max-width: 800px;
            margin: auto;
            line-height: 24px;
        }

        .invoice-box {
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
            padding: 30px;
            font-size: 16px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
        }

        .header h1 {
            margin: 0;
            color: #333;
            font-size: 28px;
        }

        .header .meta {
            text-align: right;
        }

        .section-title {
            font-weight: bold;
            text-transform: uppercase;
            color: #333;
            margin-bottom: 10px;
            font-size: 14px;
            border-bottom: 1px solid #eee;
            padding-bottom: 5px;
        }

        .addresses {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
        }

        .address-box {
            width: 45%;
        }

        .address-box p {
            margin: 0;
        }

        table {
            width: 100%;
            line-height: inherit;
            text-align: left;
            border-collapse: collapse;
        }

        table td {
            padding: 10px;
            vertical-align: top;
        }

        table tr.heading td {
            background: #eee;
            border-bottom: 1px solid #ddd;
            font-weight: bold;
        }

        table tr.item td {
            border-bottom: 1px solid #eee;
        }

        table tr.item.last td {
            border-bottom: none;
        }

        table tr.total td:nth-child(2) {
            border-top: 2px solid #eee;
            font-weight: bold;
        }

        .text-right {
            text-align: right;
        }

        .badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 4px;
            color: white;
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .badge.paid {
            background-color: #28a745;
        }

        .badge.pending {
            background-color: #ffc107;
            color: #333;
        }

        .badge.failed {
            background-color: #dc3545;
        }

        .badge.refunded {
            background-color: #6c757d;
        }

        .badge.cancelled {
            background-color: #dc3545;
        }

        .badge.returned {
            background-color: #17a2b8;
        }

        .badge.return_requested {
            background-color: #ffc107;
            color: #333;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 12px;
            color: #aaa;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }
    </style>
</head>

<body>
    <div class="invoice-box">
        <div class="header">
            <div>
                <h1>INVOICE</h1>
                <p><strong>Order #:</strong> {{order.orderNumber}}</p>
                <p><strong>Date:</strong> {{formatDate order.createdAt}}</p>
                <div style="margin-top: 20px;">
                    <h3 style="margin: 0;">{{order.storeId.name}}</h3>
                    <p style="margin: 0; font-size: 14px;">
                        <a href="https://{{order.storeId.domain}}"
                            style="color: #555; text-decoration: none;">{{order.storeId.domain}}</a>
                    </p>
                    {{#if order.storeId.settings.contact}}
                    <p style="margin: 5px 0 0 0; font-size: 12px; color: #777;">
                        {{#if order.storeId.settings.contact.address}}
                        {{order.storeId.settings.contact.address}}<br>
                        {{/if}}
                        {{#if order.storeId.settings.contact.email}}
                        Email: {{order.storeId.settings.contact.email}}
                        {{/if}}
                        {{#if order.storeId.settings.contact.phone}}
                        <span style="margin-left: 10px;">Phone: {{order.storeId.settings.contact.phone}}</span>
                        {{/if}}
                    </p>
                    {{/if}}
                </div>
            </div>
            <div class="meta">
                <h2>Total: {{formatPrice order.total order.currency order.exchangeRate}}</h2>
                <span class="badge {{order.paymentStatus}}">{{order.paymentStatus}}</span>
                {{#if (eq order.status 'cancelled')}}
                <br><br><span class="badge cancelled">CANCELLED</span>
                {{/if}}
                {{#if (eq order.status 'returned')}}
                <br><br><span class="badge returned">RETURNED</span>
                {{/if}}
                {{#if (eq order.status 'return_requested')}}
                <br><br><span class="badge return_requested">RETURN REQUESTED</span>
                {{/if}}
            </div>
        </div>

        <div class="addresses">
            <div class="address-box">
                <div class="section-title">Billed To:</div>
                <p>
                    <strong>{{order.billingAddress.firstName}} {{order.billingAddress.lastName}}</strong><br>
                    {{order.billingAddress.address1}}<br>
                    {{#if order.billingAddress.address2}}{{order.billingAddress.address2}}<br>{{/if}}
                    {{order.billingAddress.city}}, {{order.billingAddress.state}}
                    {{order.billingAddress.postalCode}}<br>
                    {{order.billingAddress.country}}<br>
                    {{order.billingAddress.phone}}
                </p>
            </div>
            <div class="address-box text-right">
                <div class="section-title">Shipped To:</div>
                <p>
                    <strong>{{order.shippingAddress.firstName}} {{order.shippingAddress.lastName}}</strong><br>
                    {{order.shippingAddress.address1}}<br>
                    {{#if order.shippingAddress.address2}}{{order.shippingAddress.address2}}<br>{{/if}}
                    {{order.shippingAddress.city}}, {{order.shippingAddress.state}}
                    {{order.shippingAddress.postalCode}}<br>
                    {{order.shippingAddress.country}}<br>
                    {{order.shippingAddress.phone}}
                </p>
            </div>
        </div>

        <table>
            <tr class="heading">
                <td>Item</td>
                <td class="text-right">Price</td>
                <td class="text-right">Quantity</td>
                <td class="text-right">Tax</td>
                <td class="text-right">Total</td>
            </tr>

            {{#each order.items}}
            <tr class="item">
                <td>
                    <strong>{{this.name}}</strong><br>
                    <small>SKU: {{this.sku}}</small>
                </td>
                <td class="text-right">{{formatPrice this.price ../order.currency ../order.exchangeRate}}</td>
                <td class="text-right">{{this.quantity}}</td>
                <td class="text-right">
                    {{#if this.taxRate}}
                    {{this.taxRate}}% ({{formatPrice this.taxAmount ../order.currency ../order.exchangeRate}})
                    {{else}}
                    -
                    {{/if}}
                </td>
                <td class="text-right">{{formatPrice (multiply this.price this.quantity) ../order.currency
                    ../order.exchangeRate}}</td>
            </tr>
            {{/each}}

            <tr class="total">
                <td colspan="4" class="text-right">Subtotal:</td>
                <td class="text-right">{{formatPrice order.subtotal order.currency order.exchangeRate}}</td>
            </tr>
            <tr class="total">
                <td colspan="4" class="text-right">Total Tax:</td>
                <td class="text-right">{{formatPrice order.tax order.currency order.exchangeRate}}</td>
            </tr>
            <tr class="total">
                <td colspan="4" class="text-right">Shipping:</td>
                <td class="text-right">{{formatPrice order.shippingCost order.currency order.exchangeRate}}</td>
            </tr>
            {{#if order.taxBreakdown}}
            {{#each order.taxBreakdown}}
            {{#if this.isSplit}}
            {{#each this.subTaxes}}
            <tr class="total" style="color: #666; font-size: 0.9em;">
                <td colspan="4" class="text-right">{{this.name}} ({{this.rate}}%):</td>
                {{!-- Assuming equal split for now, or use formula: totalAmount * (subRate / totalRate) --}}
                {{!-- For standard GST (18 -> 9+9), it's just amount / 2 --}}
                <td class="text-right">{{formatPrice (divide ../amount 2) ../../order.currency
                    ../../order.exchangeRate}}</td>
            </tr>
            {{/each}}
            {{else}}
            <tr class="total" style="color: #666; font-size: 0.9em;">
                <td colspan="4" class="text-right">{{this.name}} ({{this.rate}}%):</td>
                <td class="text-right">{{formatPrice this.amount ../order.currency ../order.exchangeRate}}</td>
            </tr>
            {{/if}}
            {{/each}}
            {{/if}}
            {{#if order.discount}}
            <tr class="total">
                <td colspan="4" class="text-right">Discount{{#if order.couponCode}} ({{order.couponCode}}){{/if}}:</td>
                <td class="text-right">-{{formatPrice order.discount order.currency order.exchangeRate}}</td>
            </tr>
            {{/if}}
            <tr class="heading">
                <td colspan="4" class="text-right">Grand Total:</td>
                <td class="text-right">{{formatPrice order.total order.currency order.exchangeRate}}</td>
            </tr>
        </table>

        <div class="footer">
            <p>Thank you for your business!</p>
            {{#if order.storeId.settings.contact}}
            <p>
                For questions, contact us at:
                {{#if order.storeId.settings.contact.email}}{{order.storeId.settings.contact.email}}{{/if}}
                {{#if order.storeId.settings.contact.phone}} | {{order.storeId.settings.contact.phone}}{{/if}}
            </p>
            {{/if}}
            {{#if order.trackingNumber}}
            <p><strong>Tracking Number:</strong> {{order.trackingNumber}} ({{order.courierName}})</p>
            {{/if}}
        </div>
    </div>
</body>

</html>