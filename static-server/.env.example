# Server Configuration
STATIC_PORT=3003
UPLOAD_DIR=../uploads

# CORS - Comma-separated list of allowed origins, or * for all
STATIC_CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Rate Limiting - Requests per minute per IP
STATIC_RATE_LIMIT=2000

# Cache Control - Max age in seconds (31536000 = 1 year)
STATIC_CACHE_MAX_AGE=31536000
