{
  "name": "infi-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-next.js",
    "dev": "next dev -p 3002",
    "prebuild": "npx tsx scripts/force-clean-next.js && npx tsx scripts/generate-menu-config.ts && npx tsx scripts/generate-store-config.ts",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "set -a; [ -f .env ] && . ./.env; set +a; PORT=${PORT:-6101} node .next/standalone/server.js",
    "lint": "eslint",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.61.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "framer-motion": "^12.24.10",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.562.0",
    "memjs": "^1.3.2",
    "next": "^16.1.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.5.0",
    "sass": "^1.96.0",
    "swiper": "^12.0.3",
    "swr": "^2.3.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/memjs": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "eslint-formatter-unix": "^9.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.17",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  }
}