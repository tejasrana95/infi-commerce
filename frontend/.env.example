
# Environment
NODE_ENV=development
NEXT_PUBLIC_SENTRY_DSN=

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

NEXT_PUBLIC_CHANNEL_CODE=WEB

STORE_DOMAIN_MAP='{"693aab5688efc150c73aa23b": ["localhost:3002", "domain-store.infitechnology.com"], "69661fe7584281f1f1c53eea": ["domain-store1.infitechnology.com"]}'

# use cache json = true - System will not call store and menu api instead it will use json file generated at build time
USE_CACHE_JSON=false 
# Store Configuration
NEXT_PUBLIC_STORE_NAME=Infi Commerce

REVALIDATION_SECRET="INFICommerce-505"

# ============================================
# Server-Side Cache (Memcached + Redis)
# Used in Route Handlers and Server Components for cross-worker caching
# ============================================

# Redis (L2 cache — disabled by default, enable if Redis is available)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=infi:fe:

# Memcached (L1 cache — fastest, disabled by default)
MEMCACHED_ENABLED=false
# Comma-separated list of server:port (supports clusters)
MEMCACHED_SERVERS=127.0.0.1:11211
MEMCACHED_KEY_PREFIX=infi:fe:
# Default item lifetime in seconds
MEMCACHED_LIFETIME=3600

# ============================================
# ISG Revalidation Configuration
# ============================================
# Controls how often statically generated pages are regenerated
# All values are in seconds

# Page-Level Revalidation (ISR)
# ----------------------------------------------
# Homepage revalidation - Default: 5 minutes (300s)
NEXT_PUBLIC_REVALIDATE_HOMEPAGE=300

# Category pages revalidation - Default: 10 minutes (600s)
NEXT_PUBLIC_REVALIDATE_CATEGORY=600

# Product pages revalidation - Default: 15 minutes (900s)
NEXT_PUBLIC_REVALIDATE_PRODUCT=900

# Blog pages revalidation - Default: 1 hour (3600s)
NEXT_PUBLIC_REVALIDATE_BLOG=3600

# Static pages revalidation - Default: 1 hour (3600s)
NEXT_PUBLIC_REVALIDATE_PAGE=3600

# Data-Level Revalidation (API Fetch Cache)
# ----------------------------------------------
# Store data (theme, menus, config) - Default: 5 minutes (300s)
NEXT_PUBLIC_REVALIDATE_STORE=300

# Store domain lookup - Default: 5 minutes (300s)
# Can be increased to 15-30 minutes as domains rarely change
NEXT_PUBLIC_REVALIDATE_STORE_DOMAIN=300

# Layouts (header, footer, page layouts) - Default: 5 minutes (300s)
NEXT_PUBLIC_REVALIDATE_LAYOUT=300

# Category metadata and filters - Default: 5 minutes (300s)
NEXT_PUBLIC_REVALIDATE_CATEGORY_DATA=300

# Individual product data - Default: 5 minutes (300s)
NEXT_PUBLIC_REVALIDATE_PRODUCT_DATA=300

# Product lists (category, search) - Default: 5 minutes (300s)
NEXT_PUBLIC_REVALIDATE_PRODUCT_LIST=300

# Blog posts list - Default: 10 minutes (600s)
NEXT_PUBLIC_REVALIDATE_BLOG_POSTS=600

# Blog categories and tags - Default: 1 hour (3600s)
NEXT_PUBLIC_REVALIDATE_BLOG_META=3600

# Currencies - Default: 1 hour (3600s)
NEXT_PUBLIC_REVALIDATE_CURRENCIES=3600

# Hero sliders and banners - Default: 5 minutes (300s)
NEXT_PUBLIC_REVALIDATE_HERO_SLIDER=300

# Note: Search results and filters are always dynamic (no cache)


# Store Domain Mapping (Optional - for build-time caching)
# Format: JSON object mapping domain to store ID
# If configured, store configs are pre-fetched at build time
# STORE_DOMAIN_MAP={"store-a.com":"675bd...","store-b.com":"693aa..."}
